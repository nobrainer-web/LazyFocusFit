{
    "name": "evanshunt/lazy-focus-fit",
    "description": "Template methods to quickly make use of FocusPoint, LazySizes, and Object-fit",
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "EvansHunt\\LazyFocusFit\\": "src/"
        }
    },
    "authors": [
        {
            "name": "David Toews",
            "email": "davejtoews@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "jonom/focuspoint": "^6",
        "silverstripe/framework": "^6",
        "silverstripe/cms": "^6"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "suggest": {
        "bigfork/silverstripe-webp-formatter": "for UseWebP()/default_webp: any module that adds Image::Webp()"
    }
}
